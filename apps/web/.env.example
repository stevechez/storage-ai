# Copy this file to .env.local for local development (Supabase values from
# `supabase status` after `supabase start`) or .env.production.local for
# production tooling (e.g. scripts/onboard-facility.mjs). Never commit
# either of those files — both are already covered by .gitignore's
# `.env*` pattern.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (Phase 38 — see docs/telephony/TWILIO_SETUP.md)
# Only required in production; the /api/twilio/voice webhook skips
# signature validation when NODE_ENV isn't "production", so these can be
# left blank for local development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Vapi (Phase 39 — see docs/telephony/VAPI_SETUP.md)
# VAPI_API_KEY is only used by scripts/setup-vapi-assistant.mjs (reads
# .env.production.local, same pattern as scripts/onboard-facility.mjs) —
# never read by the deployed app itself.
# VAPI_WEBHOOK_SECRET is required in production; the /api/vapi/webhook
# route skips the check when NODE_ENV isn't "production".
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
